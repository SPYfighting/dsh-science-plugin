{
  "name": "dsh-science-plugin",
  "version": "0.15.0",
  "description": "Scientific workbench for DeepSeek Harness: publication figures, database connections, auto result review, SSH remote compute",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "agents",
    "client",
    "skills",
    "locale",
    "assets",
    "cordis.patch.yml",
    "icon.svg",
    "docs/research/2026-11-12-生物科研能力与工作台集成调研.md",
    "docs/recipes/agent-teams-science.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-action-cards"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.2.3-0 || >=0.2.3-alpha.2 <0.2.4-0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "build:client": "node scripts/build-client.mjs"
  },
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin"
  ],
  "license": "MIT",
  "dependencies": {
    "mysql2": "^3.24.6",
    "postgres": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "@deepseek-ai/dsh-action-cards": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-action-cards": "0.2.2-rc.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SPYfighting/dsh-science-plugin.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-action-cards": ">=0.2.2-rc.3 <0.2.3-0 || >=0.2.3-alpha.2 <0.2.4-0",
    "@deepseek-ai/dsh-client-ui-action-cards": ">=0.2.2-rc.3 <0.2.3-0 || >=0.2.3-alpha.2 <0.2.4-0"
  }
}
